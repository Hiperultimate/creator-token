// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated"
  moduleFormat = "esm"
  runtime      = "bun"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  walletAddress  String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  creator             Creator?
  userTokens          UserToken[]
  transactions        Transaction[]

  @@map("users")
}

model UserToken {
  id            String   @id @default(uuid()) @db.Uuid
  walletAddress String
  tokenMint     String
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [walletAddress], references: [walletAddress], onDelete: Cascade)

  @@unique([walletAddress, tokenMint])
  @@index([walletAddress])
  @@map("user_tokens")
}

model Creator {
  creatorAddress  String   @id
  displayName     String
  bio             String?
  identityAddress String   @unique
  createdAt       DateTime @default(now())

  user   User   @relation(fields: [creatorAddress], references: [walletAddress], onDelete: Cascade, map: "creator_user_fk")
  posts  Post[]
  token  CreatorToken @relation(fields: [creatorAddress], references: [creatorAddress], map: "creator_token_fk")

  @@map("creators")
}

model CreatorToken {
  id               String   @id @default(uuid()) @db.Uuid
  creatorAddress   String   @unique
  tokenMintAddress String   @unique
  basePrice        BigInt
  slope            BigInt
  createdAt        DateTime @default(now())

  creator Creator?

  @@map("tokens")
}

model Post {
  id             String       @id @default(uuid()) @db.Uuid
  creatorAddress String
  contentUrl     String
  contentType    ContentType
  tokenThreshold BigInt
  createdAt      DateTime     @default(now())

  creator Creator @relation(fields: [creatorAddress], references: [creatorAddress], onDelete: Cascade)

  @@index([creatorAddress, createdAt])
  @@map("posts")
}

model Transaction {
  id             String          @id @default(uuid()) @db.Uuid
  tokenMint      String
  type           TransactionType
  amount         BigInt
  walletAddress  String
  timestamp      DateTime        @default(now())

  user           User            @relation(fields: [walletAddress], references: [walletAddress], onDelete: Cascade)

  @@index([tokenMint, timestamp])
  @@index([walletAddress])
  @@map("transactions")
}

enum ContentType {
  TEXT
  IMAGE
  VIDEO
}

enum TransactionType {
  BUY
  SELL
}